<!-- pages/record-edit/record-edit.wxml -->
<view class="container">
  <!-- 头部操作栏 -->
  <view class="header">
    <view class="header-left">
      <button class="btn-cancel" bindtap="onCancel">取消</button>
    </view>
    <view class="header-title">添加记录</view>
    <view class="header-right">
      <button class="btn-save {{!content ? 'disabled' : ''}}" bindtap="onSave" disabled="{{!content}}">保存</button>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="main-content">
    <!-- 宠物选择 -->
    <view class="section pet-selector" wx:if="{{pets.length > 1}}">
      <view class="section-title">选择宠物</view>
      <view class="pet-list">
        <block wx:for="{{pets}}" wx:key="petId">
          <view 
            class="pet-item {{selectedPetId === item.petId ? 'active' : ''}}"
            data-pet-id="{{item.petId}}"
            bindtap="onSelectPet"
          >
            <image class="pet-avatar" src="{{item.avatar}}" wx:if="{{item.avatar}}" />
            <view class="pet-avatar pet-avatar-placeholder" wx:else>🐾</view>
            <text class="pet-name">{{item.name}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 记录类型选择 -->
    <view class="section type-selector">
      <view class="section-title">记录类型</view>
      <view class="type-list">
        <view 
          class="type-item {{recordType === 'diary' ? 'active' : ''}}" 
          data-type="diary"
          bindtap="onSelectType"
        >
          <text class="type-icon">📝</text>
          <text class="type-name">日记</text>
        </view>
        <view 
          class="type-item {{recordType === 'health' ? 'active' : ''}}" 
          data-type="health"
          bindtap="onSelectType"
        >
          <text class="type-icon">🏥</text>
          <text class="type-name">健康</text>
        </view>
        <view 
          class="type-item {{recordType === 'activity' ? 'active' : ''}}" 
          data-type="activity"
          bindtap="onSelectType"
        >
          <text class="type-icon">🎪</text>
          <text class="type-name">活动</text>
        </view>
      </view>
    </view>

    <!-- 健康记录额外信息 -->
    <view class="section health-extra" wx:if="{{recordType === 'health'}}">
      <view class="section-title">健康项目</view>
      <picker 
        class="health-picker" 
        range="{{healthTypes}}" 
        range-key="name"
        value="{{healthTypeIndex}}"
        bindchange="onHealthTypeChange"
      >
        <view class="picker-content">
          <text class="picker-text">{{healthTypes[healthTypeIndex].name}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 内容输入区域 -->
    <view class="section content-input">
      <textarea 
        class="content-textarea" 
        placeholder="记录下此刻的心情或重要信息..." 
        placeholder-class="placeholder"
        maxlength="500"
        value="{{content}}"
        bindinput="onContentInput"
        show-confirm-bar="{{false}}"
        auto-height
      ></textarea>
      <view class="word-count">{{content.length}}/500</view>
    </view>

    <!-- 图片上传区域 -->
    <view class="section image-upload">
      <view class="section-title">添加图片 ({{images.length}}/9)</view>
      <view class="image-list">
        <!-- 已上传的图片 -->
        <block wx:for="{{images}}" wx:key="*this" wx:for-item="image" wx:for-index="index">
          <view class="image-item">
            <image class="image-preview" src="{{image}}" mode="aspectFill" />
            <view class="image-remove" data-index="{{index}}" bindtap="onRemoveImage">×</view>
          </view>
        </block>
        
        <!-- 添加图片按钮 -->
        <view class="image-item add-image" wx:if="{{images.length < 9}}" bindtap="onAddImage">
          <view class="add-icon">+</view>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 活动记录额外信息 -->
    <view class="section activity-extra" wx:if="{{recordType === 'activity'}}">
      <view class="section-title">关联活动</view>
      <picker 
        class="activity-picker" 
        range="{{activities}}" 
        range-key="title"
        value="{{activityIndex}}"
        bindchange="onActivityChange"
      >
        <view class="picker-content">
          <text class="picker-text">{{activities[activityIndex] ? activities[activityIndex].title : '选择活动'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 加载遮罩 -->
  <view class="loading-mask" wx:if="{{isLoading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">保存中...</text>
    </view>
  </view>
</view>